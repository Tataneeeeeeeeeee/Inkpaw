/* =============================================================================
   rofi/themes/menu.rasi — list menus (settings, Wi-Fi, Bluetooth, power…)
   =============================================================================
   HyDE-style: wide opaque panel, picture of the current wallpaper on the left,
   search + list on the right. ../colors.rasi is GENERATED by hyprtheme
   (palette, accents, fonts, side-image).
   ============================================================================= */
@import "../colors.rasi"

configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

* {
    font: @ui-font;
    background-color: transparent;
    text-color: @on-surface;
}

window {
    location: center;
    width: 860px;
    background-color: @panel;
    border: 2px;
    border-color: @a1;
    border-radius: @ui-radius;
}

mainbox {
    orientation: horizontal;
    spacing: 0;
    children: [ imagebox, listbox ];
}

/* Left: wallpaper picture */
imagebox {
    expand: false;
    width: 300px;
    background-image: @side-image;
    border-radius: 14px 0 0 14px;
}

/* Right: prompt, search, list */
listbox {
    padding: 22px 20px 18px 20px;
    spacing: 14px;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 12px 16px;
    spacing: 12px;
    background-color: @panel-high;
    border-radius: 12px;
    children: [ prompt, entry ];
}
prompt { text-color: @a1; }
entry  { placeholder: "Search…"; placeholder-color: @on-surface-variant; cursor: text; }

message { background-color: @panel-high; border-radius: 10px; padding: 10px 14px; }
textbox { text-color: @on-surface-variant; }

listview {
    lines: 9;
    columns: 1;
    scrollbar: false;
    spacing: 4px;
    fixed-height: true;
    cycle: true;
}

element { padding: 10px 14px; border-radius: 10px; spacing: 12px; }
element normal.normal, element alternate.normal { background-color: transparent; }
element normal.active { text-color: @a1; }
element selected.normal, element selected.active {
    background-image: @grad-accent;
    text-color: @panel;
}
element-text { text-color: inherit; vertical-align: 0.5; }
element-icon { size: 22px; }
