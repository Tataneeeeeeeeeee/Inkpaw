/* =============================================================================
   rofi/themes/launcher.rasi — app search (fallback when Walker is missing)
   =============================================================================
   Same HyDE layout as menu.rasi, with app icons and a larger list.
   ============================================================================= */
@import "menu.rasi"

configuration {
    show-icons: true;
    display-drun: "Apps";
    drun-display-format: "{name}";
}

window   { width: 940px; }
imagebox { width: 320px; }
listview { lines: 10; }
element-icon { size: 26px; }
