/* =============================================================================
   rofi/skins/encre/menu.rasi — list menus of the "encre" skin (ink & parchment)
   =============================================================================
   Loaded instead of rofi/themes/menu.rasi when UI_SKIN=encre (rofi_menu in
   hypr/scripts/lib.sh, via hypr/scripts/rofi-theme.sh): settings, Wi-Fi,
   Bluetooth, monitors, screenshot, edit-config, power fallback.
   Look (mockup Mew-Monitors): opaque parchment sheet, 3px ink outline, the
   right / bottom edges drawn thicker to fake the hard ink shadow (rofi has no
   box-shadow), brush-pen title (Caveat Brush), dashed search field, a cat
   sitting in the corner, rows as little cards: selected = ochre + ink.
   Colors / fonts: ../../colors.rasi + tokens.rasi, both GENERATED by hyprtheme
   (template hyprtheme/templates/rofi-encre.rasi).
   ============================================================================= */
@import "../../colors.rasi"
@import "tokens.rasi"

configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

* {
    font: @font-body;
    background-color: transparent;
    text-color: @ink;
}

window {
    location: center;
    width: 760px;
    background-color: @paper;
    border: 3px 7px 7px 3px;
    border-color: @ink;
    border-radius: 16px;
}

mainbox {
    padding: 18px 26px 24px 26px;
    spacing: 14px;
    children: [ inputbar, message, listview ];
}

/* Header: title, dashed search field, a sitting cat */
inputbar {
    orientation: horizontal;
    spacing: 16px;
    children: [ prompt, searchbox, cat ];
}
prompt {
    font: @font-title;
    text-color: @ink;
    vertical-align: 0.5;
}
searchbox {
    expand: true;
    orientation: horizontal;
    padding: 8px 14px;
    margin: 18px 0 14px 0;
    background-color: @card;
    border: 2px dash;
    border-color: @ink;
    border-radius: 12px;
    children: [ entry ];
}
entry {
    placeholder: "Search…";
    placeholder-color: @muted;
    cursor: text;
    vertical-align: 0.5;
}
cat {
    expand: false;
    width: 76px;
    background-image: @cat-sit;
}

message {
    padding: 8px 14px;
    background-color: @paper-dark;
    border: 2px dash;
    border-color: @ink-dim;
    border-radius: 12px;
}
textbox { font: @font-small; text-color: @muted; }

listview {
    lines: 8;
    columns: 1;
    scrollbar: false;
    spacing: 8px;
    fixed-height: false;
    cycle: true;
}

/* Rows: paper cards with an ink outline; selected = ochre fill, ink border */
element {
    padding: 8px 14px;
    spacing: 12px;
    border: 2px 3px 3px 2px;
    border-radius: 12px;
    border-color: @ink;
    background-color: @card;
}
element normal.normal, element alternate.normal { background-color: @card; }
element normal.active, element alternate.active { background-color: @card; text-color: @accent-text; }
element normal.urgent, element alternate.urgent { background-color: @card; text-color: @brick; }
element selected.normal, element selected.active, element selected.urgent {
    background-color: @ochre;
    text-color: @on-ochre;
}
element-text { text-color: inherit; vertical-align: 0.5; }
element-icon { size: 22px; }
