/* =============================================================================
   rofi/skins/encre/keys.rasi — keybind cheat sheet of the "encre" skin
   =============================================================================
   Used by hypr/scripts/menus/keybindings.sh when UI_SKIN=encre (mockup
   Mew-Keys): a big parchment sheet, "Keybindings" in Caveat Brush, the binds
   on a card in 3 columns. Rows are pango markup made by keybindings.sh: keys
   drawn as little caps (Courier Prime on the card color), then the action.
   Colors / fonts: ../../colors.rasi + tokens.rasi (GENERATED by hyprtheme).
   ============================================================================= */
@import "../../colors.rasi"
@import "tokens.rasi"

configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
}

* {
    font: @font-body;
    background-color: transparent;
    text-color: @ink;
}

window {
    location: center;
    width: 92%;
    background-color: @paper;
    border: 3px 8px 8px 3px;
    border-color: @ink;
    border-radius: 16px;
}

mainbox {
    padding: 14px 30px 26px 30px;
    spacing: 12px;
    children: [ inputbar, listview ];
}

/* Header: big brush title, dashed filter, a cat peeking */
inputbar {
    orientation: horizontal;
    spacing: 20px;
    children: [ prompt, textbox-hint, searchbox, cat ];
}
prompt {
    font: @font-title-big;
    vertical-align: 0.5;
}
textbox-hint {
    expand: false;
    vertical-align: 0.5;
    font: @font-small;
    text-color: @muted;
    content: "type to filter · Esc to close";
}
searchbox {
    expand: true;
    padding: 8px 14px;
    margin: 22px 0 18px 0;
    background-color: @card;
    border: 2px dash;
    border-color: @ink;
    border-radius: 12px;
    children: [ entry ];
}
entry {
    placeholder: "Filter…";
    placeholder-color: @muted;
    cursor: text;
    vertical-align: 0.5;
}
cat {
    expand: false;
    width: 84px;
    background-image: @cat-peek;
}

/* The binds sit on a card */
listview {
    lines: 18;
    columns: 3;
    fixed-columns: true;
    fixed-height: true;
    scrollbar: false;
    spacing: 4px 18px;
    padding: 14px 16px;
    cycle: true;
    background-color: @card;
    border: 3px;
    border-color: @ink;
    border-radius: 14px;
}

element {
    padding: 3px 8px;
    border: 2px;
    border-radius: 9px;
    border-color: transparent;
}
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal {
    background-color: @ochre;
    border-color: @ink;
    text-color: @on-ochre;
}
element-text { text-color: inherit; vertical-align: 0.5; font: @font-dense; }
