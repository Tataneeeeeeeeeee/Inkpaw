{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "_comment": "swaync — notification daemon + control center. JSON has no comments: see README § Notifications. Quick toggles call hypr/scripts/radio.sh. scripts.history logs every notification for the quick panel (hypr/scripts/notif-log.sh). Control center: right side, vertically centered, 960 px high (popups keep positionX/positionY).",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 400,
  "control-center-height": 960,
  "control-center-margin-top": 0,
  "control-center-margin-right": 10,
  "control-center-margin-bottom": 0,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 120,
  "notification-body-image-width": 220,
  "timeout": 6,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": false,
  "widgets": [
    "title",
    "buttons-grid",
    "dnd",
    "volume",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 12
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "active": true,
          "command": "sh -c '${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/radio.sh wifi set'",
          "update-command": "sh -c '${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/radio.sh wifi state'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": true,
          "command": "sh -c '${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/radio.sh bluetooth set'",
          "update-command": "sh -c '${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/radio.sh bluetooth state'"
        },
        {
          "label": "󰸉",
          "command": "sh -c 'swaync-client -cp; ${XDG_CONFIG_HOME:-$HOME/.config}/hyprtheme/wallpaper-picker.sh'"
        },
        {
          "label": "󰒓",
          "command": "sh -c 'swaync-client -cp; ${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/settings-ui.sh'"
        },
        {
          "label": "󰹑",
          "command": "sh -c 'swaync-client -cp; sleep 0.3; ${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/screenshot.sh area-edit'"
        },
        {
          "label": "󰔎",
          "command": "sh -c '${XDG_CONFIG_HOME:-$HOME/.config}/hyprtheme/theme.sh mode toggle'"
        },
        {
          "label": "󰌾",
          "command": "sh -c 'swaync-client -cp; ${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/lock.sh'"
        },
        {
          "label": "󰐥",
          "command": "sh -c 'swaync-client -cp; ${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/menus/power.sh'"
        }
      ]
    }
  },
  "scripts": {
    "history": {
      "exec": "sh -c '${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/notif-log.sh'",
      "app-name": ".*",
      "run-on": "receive"
    }
  },
  "control-center-positionX": "right",
  "control-center-positionY": "center",
  "control-center-margin-left": 0
}
