/* @output: rofi/colors.rasi */
/* =============================================================================
   GENERATED by hyprtheme (template: hyprtheme/templates/rofi.rasi)
   Imported by every theme in rofi/themes/ (no glob here: rofi nests comments)
   ============================================================================= */
* {
    primary:            {{colors.primary.default.hex}};
    on-primary:         {{colors.on_primary.default.hex}};
    primary-soft:       {{colors.primary.default.hex}}2e;
    surface:            {{colors.surface.default.hex}}{{ui.opacity_hex}};
    surface-high:       {{colors.surface_container_high.default.hex}}b3;
    on-surface:         {{colors.on_surface.default.hex}};
    on-surface-variant: {{colors.on_surface_variant.default.hex}};
    hover:              {{colors.on_surface.default.hex}}14;
    hairline:           {{colors.on_surface.default.hex}}14;
    error:              {{colors.error.default.hex}};

    a1:                 {{accent.a1}};
    a1-soft:            {{accent.a1}}40;
    a2:                 {{accent.a2}};
    a2-soft:            {{accent.a2}}40;
    a3:                 {{accent.a3}};
    a3-soft:            {{accent.a3}}40;
    a4:                 {{accent.a4}};
    a4-soft:            {{accent.a4}}40;
    a5:                 {{accent.a5}};
    a5-soft:            {{accent.a5}}40;
    a6:                 {{accent.a6}};
    a6-soft:            {{accent.a6}}40;

    /* rofi only accepts literal colors inside gradients: whole gradients as variables */
    grad-select:        linear-gradient(to right, {{accent.a1}}40, {{accent.a3}}40);
    grad-select-tile:   linear-gradient(135deg, {{accent.a1}}40, {{accent.a4}}40);

    /* opaque panels (HyDE-style menus) */
    panel:              {{colors.surface_container_low.default.hex}};
    panel-high:         {{colors.surface_container_high.default.hex}};
    panel-highest:      {{colors.surface_container_highest.default.hex}};
    band:               {{colors.surface.default.hex}}b8;
    side-image:         url("{{ui.side_image}}", height);
    grad-accent:        linear-gradient(to right, {{accent.a1}}, {{accent.a3}});

    ui-font:            "{{ui.font}} {{ui.font_size}}";
    ui-icon-font:       "{{ui.icon_font}} {{ui.font_size}}";
    ui-radius:          {{ui.radius}}px;
}
