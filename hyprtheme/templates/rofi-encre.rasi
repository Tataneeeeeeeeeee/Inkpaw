/* @output: rofi/skins/encre/tokens.rasi */
/* =============================================================================
   GENERATED by hyprtheme (template: hyprtheme/templates/rofi-encre.rasi)
   Tokens of the "encre" skin (ink & parchment) for the rofi menus in
   rofi/skins/encre/. Material roles only (see hyprtheme/skins/encre/README.md),
   so the night sibling (encre-nuit) works too. Also read by
   hypr/scripts/rofi-theme.sh (rofi_token) for pango markup (keybindings.sh)
   and the slurp colors (screenshot.sh, hypr/scripts/skin-bin/slurp):
   keep one "name: value;" per line.
   ============================================================================= */
* {
    ink:          {{colors.on_surface.default.hex}};
    ink-shadow:   {{colors.shadow.default.hex}};
    ink-faint:    {{colors.on_surface.default.hex}}38;
    ink-dim:      {{colors.on_surface.default.hex}}8c;
    paper:        {{colors.surface.default.hex}};
    paper-dark:   {{colors.surface_container_high.default.hex}};
    card:         {{colors.surface_container_lowest.default.hex}};
    muted:        {{colors.on_surface_variant.default.hex}};
    ochre:        {{colors.primary_container.default.hex}};
    on-ochre:     {{colors.on_primary_container.default.hex}};
    accent-text:  {{colors.primary.default.hex}};
    brick:        {{colors.error.default.hex}};
    moss:         {{colors.secondary_container.default.hex}};
    slate:        {{colors.tertiary_container.default.hex}};

    font-body:    "{{ui.font}} SemiBold {{ui.font_size}}";
    font-small:   "{{ui.font}} Medium 10";
    font-title:   "{{ui.display_font}} 30";
    font-title-big: "{{ui.display_font}} 40";
    font-dense:   "{{ui.font}} SemiBold 11";
    font-card:    "{{ui.display_font}} 17";
    font-mono:    "{{ui.mono_font}} Bold {{ui.font_size}}";
    mono-family:  "{{ui.mono_font}}";

    cat-sit:      url("{{ui.skin_dir}}/cats/sit-moumoute.png", height);
    cat-peek:     url("{{ui.skin_dir}}/cats/peek-gribouille.png", height);
    cat-sleep:    url("{{ui.skin_dir}}/cats/sleep-biscotte.png", height);
}
