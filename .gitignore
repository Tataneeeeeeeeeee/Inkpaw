# =============================================================================
#  .gitignore — Inkpaw
# =============================================================================
# Python caches
__pycache__/
*.pyc

# Files GENERATED by the theme engine (hyprtheme/templates/*, "@output:" lines).
# They are rendered from the palette at every login / theme change and contain
# machine-specific paths: never commit them. (kitty/inkpaw-theme.conf is kept:
# the engine writes the session's own copy, this one is the first-login default.)
/aichat/skins/encre.css
/gtk-3.0/gtk.css
/gtk-4.0/gtk.css
/hypr/hyprlock-colors.conf
/hypr/skins/hyprlock-encre.conf
/hypr/themes/current.lua
/quickpanel/skins/encre.css
/rofi/colors.rasi
/rofi/skins/encre/tokens.rasi
/settings-app/skins/encre.css
/spotlight/colors.css
/spotlight/skins/encre.css
/swaync/colors.css
/swaync/skins/encre.css
/swayosd/colors.css
/swayosd/skins/encre.css
/walker/themes/inkpaw/colors.css
/waybar/style/colors.css
/wlogout/colors.css
/wlogout/skins/encre/style.css

# Written by the session / installer into a clone run as the config root
/gtk-3.0/
/gtk-4.0/
/kitty/kitty.conf
/kitty/inkpaw-settings.conf

# Editor / OS leftovers
*~
*.swp
.DS_Store
